{
  "name": "adb-kit",
  "version": "0.9.0",
  "description": "Desktop tool to mirror, control and debug Android devices over ADB",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:all": "electron-vite build && electron-builder -mwl",
    "cli": "electron . --run"
  },
  "build": {
    "appId": "dev.adbkit.desktop",
    "productName": "ADB Kit",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
